@model its_a_date_project.Models.ViewModels.InviteViewModel
@{
    Layout = null;
    var t = Model.Theme;
    var dir = Model.IsRtl ? "rtl" : "ltr";
    var otherLang = Model.IsRtl ? "en" : "ar";
    var otherLangLabel = Model.IsRtl ? "English" : "العربية";
    var dateIconSvg = FieldIconSvg("<rect x='3' y='4' width='18' height='18' rx='3'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/>");
    var timeIconSvg = FieldIconSvg("<circle cx='12' cy='12' r='9'/><polyline points='12 7 12 12 15.5 14'/>");
}
@functions {
    // Purely decorative — the native picker indicator stays hidden-but-clickable (see CSS), so this
    // icon never has to compete with a second, browser-drawn one next to it.
    string FieldIconSvg(string innerShapes)
    {
        return "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' width='60%' height='60%'>" + innerShapes + "</svg>";
    }
}
<!doctype html>
<html lang="@Model.Lang" dir="@dir">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light">
<link rel="icon" href="/favicon.ico">
<title>@Model.Text["Headline"]</title>
<style>
  :root{
    --bg-1:@t.BgStart;
    --bg-2:@t.BgEnd;
    --card-bg:@t.CardBg;
    --ink:@t.Ink;
    --ink-soft:@t.InkSoft;
    --accent:@t.Accent;
    --accent-deep:@t.AccentDeep;
    --accent-soft:@t.AccentSoft;
    --gold:@t.Gold;
    --border:@t.Border;
    --shadow:@t.ShadowRgba;
    color-scheme: light;
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}

  .stage{
    position:relative;
    min-height:100vh;
    min-height:100dvh;
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:6vh 5vw;
    overflow:hidden;
    background:
      radial-gradient(60% 50% at 50% 8%, var(--bg-1) 0%, transparent 70%),
      linear-gradient(160deg, var(--bg-1), var(--bg-2));
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    color:var(--ink);
  }

  .lang-switch{
    position:absolute;
    top:16px;
    inset-inline-end:16px;
    z-index:30;
    background:var(--card-bg);
    color:var(--ink-soft);
    border:1px solid var(--border);
    border-radius:999px;
    padding:0.4rem 0.9rem;
    font-size:0.8rem;
    text-decoration:none;
  }

  .hearts{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
  .hearts span{
    position:absolute;
    bottom:-10%;
    opacity:0.55;
    animation:float 11s linear infinite;
  }
  @@media (prefers-reduced-motion: reduce){
    .hearts span{animation:none;display:none;}
    .card, #yes-btn, #no-btn, #submit-btn, .burst span, .heart-burst-item, .sticker-heart{transition:none !important; animation:none !important;}
  }
  @@keyframes float{
    0%{transform:translateY(0) rotate(0deg);opacity:0;}
    10%{opacity:0.6;}
    100%{transform:translateY(-115vh) rotate(25deg);opacity:0;}
  }

  @@keyframes glow{
    0%,100%{box-shadow:0 10px 24px -8px var(--shadow);}
    50%{box-shadow:0 12px 30px -4px var(--accent);}
  }
  @@keyframes heartGlow{
    0%,100%{ filter:drop-shadow(0 0 4px var(--accent)) drop-shadow(0 0 2px var(--accent)); opacity:0.65; }
    50%{ filter:drop-shadow(0 0 26px var(--accent)) drop-shadow(0 0 14px var(--accent)) drop-shadow(0 0 6px #fff); opacity:1; }
  }
  .sticker-heart{ animation:heartGlow 1.8s ease-in-out infinite; }
  @@keyframes wiggle{
    0%,100%{transform:rotate(0deg);}
    25%{transform:rotate(-5deg);}
    75%{transform:rotate(5deg);}
  }

  .card{
    position:relative;
    z-index:2;
    width:min(460px,92vw);
    background:var(--card-bg);
    border:1px solid var(--border);
    border-radius:28px;
    padding:clamp(2rem,5vw,3rem) clamp(1.6rem,5vw,2.6rem);
    box-shadow:0 30px 60px -20px var(--shadow), 0 2px 0 var(--border) inset;
    text-align:center;
    transform:rotate(-0.6deg);
  }

  .eyebrow{
    display:inline-block;
    font-family:"Segoe Script","Bradley Hand","Brush Script MT",cursive;
    font-size:1.25rem;
    color:var(--accent-deep);
    margin:0 0 0.2rem;
    transform:rotate(-2deg);
  }

  h1{
    font-family:Georgia,"Iowan Old Style","Palatino Linotype",serif;
    font-style:italic;
    font-weight:700;
    font-size:clamp(1.9rem,6vw,2.7rem);
    line-height:1.15;
    margin:0.2rem 0 0.6rem;
    text-wrap:balance;
    color:var(--ink);
  }

  .sub{
    font-size:0.98rem;
    color:var(--ink-soft);
    margin:0 0 1.8rem;
    line-height:1.5;
  }

  .btn-row{
    display:flex;
    flex-wrap:wrap;
    gap:1rem;
    justify-content:center;
    align-items:center;
    min-height:64px;
  }

  button{
    font-family:inherit;
    cursor:pointer;
    border:none;
    border-radius:999px;
    font-size:1.02rem;
    font-weight:600;
    letter-spacing:0.01em;
    padding:0.85rem 1.9rem;
  }
  button:focus-visible{
    outline:3px solid var(--gold);
    outline-offset:3px;
  }

  #yes-btn{
    background:linear-gradient(135deg,var(--accent),var(--accent-deep));
    color:#fff;
    box-shadow:0 10px 24px -8px var(--shadow);
    transition:transform 0.25s ease, box-shadow 0.25s ease;
    animation:glow 1.7s ease-in-out infinite;
  }
  #yes-btn:hover{transform:translateY(-2px) scale(1.04);}

  #no-btn{
    background:var(--accent-soft);
    color:var(--ink);
    transition:transform 0.18s ease, left 0.28s cubic-bezier(.2,.9,.3,1.3), top 0.28s cubic-bezier(.2,.9,.3,1.3);
    animation:wiggle 2.6s ease-in-out infinite;
  }
  #no-btn.roaming{
    position:absolute;
    z-index:20;
    animation:none;
  }

  .helper{
    margin-top:1.4rem;
    font-size:0.88rem;
    color:var(--ink-soft);
    min-height:1.2em;
  }

  form{display:flex;flex-direction:column;gap:1.1rem;text-align:left;}
  [dir="rtl"] form{text-align:right;}
  label{
    font-size:0.78rem;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:var(--ink-soft);
    display:block;
    margin-bottom:0.4rem;
  }
  .field-wrap{
    display:flex;
    align-items:center;
    gap:0.9rem;
    width:100%;
    min-height:52px;
    border-radius:14px;
    border:2px solid var(--border);
    background-color:var(--bg-1);
    padding:0.6rem 0.9rem;
    cursor:pointer;
  }
  .field-wrap:focus-within{
    border-color:var(--accent);
  }
  input[type="date"], input[type="time"]{
    color-scheme: light;
    -webkit-appearance: none;
    appearance: none;
    position:relative;
    flex:1;
    min-width:0;
    border:none;
    background:transparent;
    padding:0.4rem 0;
    font-family:inherit;
    font-size:1.05rem;
    color:var(--ink);
    -webkit-text-fill-color:var(--ink);
    cursor:pointer;
  }
  input[type="date"]:focus, input[type="time"]:focus{
    outline:none;
  }
  /* Hide the native calendar/clock icon but keep it as an invisible full-size click target on the
     input itself — belt-and-suspenders alongside the wrapper-level click handler in the script below.
     WebKit/Blink only (Chrome, Safari, Edge, iOS) — Firefox has no CSS hook for this at all. */
  input[type="date"]::-webkit-calendar-picker-indicator,
  input[type="time"]::-webkit-calendar-picker-indicator{
    background:transparent;
    color:transparent;
    cursor:pointer;
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
  }
  .field-icon{
    flex-shrink:0;
    width:2.2rem;
    height:2.2rem;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:10px;
    background:var(--accent-soft);
    border:1.5px solid var(--accent);
    color:var(--accent);
  }
  .field-row{display:flex;gap:0.8rem;}
  .field-row > div{flex:1;min-width:0;}
  @@media (max-width:480px){
    .field-row{flex-direction:column;gap:1.1rem;}
  }

  #submit-btn{
    margin-top:0.3rem;
    background:linear-gradient(135deg,var(--accent),var(--accent-deep));
    color:#fff;
    width:100%;
    box-shadow:0 10px 24px -8px var(--shadow);
    transition:transform 0.2s ease;
    animation:glow 1.7s ease-in-out infinite;
  }
  #submit-btn:hover{transform:translateY(-2px);}

  .thanks-msg{
    font-size:1.02rem;
    line-height:1.6;
    color:var(--ink);
    margin:0 0 0.4rem;
  }
  .love-line{
    font-family:Georgia,"Iowan Old Style",serif;
    font-style:italic;
    font-size:1.3rem;
    color:var(--accent-deep);
    margin:1.1rem 0 0;
  }

  .scene{display:none;animation:fadeIn 0.5s ease;}
  .scene.active{display:block;}
  @@keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

  .burst{position:relative;height:0;}
  .burst span{
    position:absolute;
    left:50%;top:0;
    animation:pop 1.1s ease-out forwards;
  }
  @@keyframes pop{
    0%{transform:translate(-50%,0) scale(0.4);opacity:1;}
    100%{transform:translate(calc(-50% + var(--dx)), -80px) scale(1);opacity:0;}
  }

  .heart-burst-item{
    position:fixed;
    left:0;top:0;
    pointer-events:none;
    z-index:60;
    animation:burstPop 1s ease-out forwards;
  }
  @@keyframes burstPop{
    0%{transform:translate(-50%,-50%) scale(0.3);opacity:1;}
    100%{transform:translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1);opacity:0;}
  }
</style>
</head>
<body>
<div class="stage" id="stage">
  <a class="lang-switch" href="?lang=@otherLang">@otherLangLabel</a>
  <div class="hearts" id="hearts"></div>

  <div class="card" id="card">

    <section class="scene active" id="scene-ask">
      <p class="eyebrow">@Model.Text["Eyebrow"]</p>
      <h1>@Model.Text["Headline"]</h1>
      <p class="sub">@Model.Text["Subhead"]</p>
      <div class="btn-row" id="btn-row">
        <button id="yes-btn" type="button">@Model.Text["YesButton"]</button>
        <button id="no-btn" type="button">@Model.Text["NoButton"]</button>
      </div>
      <p class="helper" id="helper" aria-live="polite">&nbsp;</p>
    </section>

    <section class="scene" id="scene-plan">
      <p class="eyebrow">@Model.Text["PlanEyebrow"]</p>
      <h1 style="font-size:clamp(1.6rem,5vw,2.1rem);">@Model.Text["PlanHeadline"]</h1>
      <p class="sub">@Model.Text["PlanSubhead"]</p>
      <form id="plan-form">
        <div class="field-row">
          <div>
            <label for="date-input">@Model.Text["DateLabel"]</label>
            <div class="field-wrap">
              <input type="date" id="date-input" required>
              <span class="field-icon" aria-hidden="true">@Html.Raw(dateIconSvg)</span>
            </div>
          </div>
          <div>
            <label for="time-input">@Model.Text["TimeLabel"]</label>
            <div class="field-wrap">
              <input type="time" id="time-input" required>
              <span class="field-icon" aria-hidden="true">@Html.Raw(timeIconSvg)</span>
            </div>
          </div>
        </div>
        <button id="submit-btn" type="submit">@Model.Text["SubmitButton"]</button>
      </form>
    </section>

    <section class="scene" id="scene-thanks">
      <p class="eyebrow">@Model.Text["ThanksEyebrow"]</p>
      <h1 style="font-size:clamp(1.6rem,5vw,2.1rem);">@Model.Text["ThanksHeadline"]</h1>
      <p class="thanks-msg" id="thanks-msg"></p>
      <p class="love-line">@Model.Text["LoveLine"]</p>
      <div class="burst" id="burst"></div>
    </section>

  </div>
</div>

<script>
(function(){
  var SUBMIT_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Submit", "Invite", new { slug = Model.Invite.Slug })));
  var THANKS_TEMPLATE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Text["ThanksMessageTemplate"]));
  var LOCALE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lang == "ar" ? "ar" : "en"));
  var DODGE_LINES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new [] {
      Model.Text["DodgeLine1"], Model.Text["DodgeLine2"], Model.Text["DodgeLine3"],
      Model.Text["DodgeLine4"], Model.Text["DodgeLine5"], Model.Text["DodgeLine6"]
  }));

  // Real SVG hearts (not emoji) so they always take the theme's own colors —
  // emoji glyphs like 💗 carry their own built-in color and ignore CSS `color`.
  var HEART_PATH = 'M23.6 0c-3 0-5.7 1.6-7.6 4.3C14.1 1.6 11.4 0 8.4 0 3.8 0 0 3.9 0 8.9c0 8.7 12.4 16.7 15.4 19.1.3.3.8.3 1.1 0C19.6 25.6 32 17.6 32 8.9 32 3.9 28.2 0 23.6 0z';
  // One hue for every heart — variety comes from randomized saturation/lightness per instance
  // (via CSS filter) rather than mixing in different theme colors.
  var HEART_COLOR = 'var(--accent)';
  var STICKER_OUTLINE = '#4a3b3f';

  function randomHeartFilter(){
    var saturate = 45 + Math.random() * 90;   // 45%–135%
    var brightness = 85 + Math.random() * 35; // 85%–120%
    return 'saturate(' + saturate.toFixed(0) + '%) brightness(' + brightness.toFixed(0) + '%)';
  }

  // "Sticker" heart — thick outline, glossy fill, star + sparkle accent — with its own glow-pulse
  // animation (.sticker-heart, defined above) applied to the <svg> itself, independent of the
  // outer span's drift animation.
  function stickerHeartMarkup(fillColor){
    return '<svg class="sticker-heart" viewBox="0 0 100 100" width="100%" height="100%" style="display:block;overflow:visible;">' +
      '<path d="M50 32C50 32 39 12 20 12C8 12 2 22 2 34C2 58 50 88 50 88C50 88 98 58 98 34C98 22 92 12 80 12C61 12 50 32 50 32Z" ' +
        'fill="' + fillColor + '" stroke="' + STICKER_OUTLINE + '" stroke-width="7" stroke-linejoin="round"/>' +
      '<g transform="translate(-4,-2) scale(0.85)">' +
        '<path d="M18 0 L22 12 L34 16 L22 20 L18 32 L14 20 L2 16 L14 12 Z" fill="var(--gold)" stroke="' + STICKER_OUTLINE + '" stroke-width="3" stroke-linejoin="round"/>' +
      '</g>' +
      '<g transform="translate(30,2) scale(0.45)">' +
        '<path d="M10 0 L12 8 L20 10 L12 12 L10 20 L8 12 L0 10 L8 8 Z" fill="#fff6da" stroke="' + STICKER_OUTLINE + '" stroke-width="4" stroke-linejoin="round"/>' +
      '</g>' +
    '</svg>';
  }

  function makeHeartIcon(colorVar, sizeRem, variant){
    var span = document.createElement('span');
    span.style.display = 'inline-block';
    span.style.width = (variant === 'double' ? sizeRem * 1.4 : sizeRem) + 'rem';
    span.style.height = sizeRem + 'rem';
    span.style.color = colorVar;
    span.style.filter = randomHeartFilter();
    if (variant === 'sticker'){
      span.innerHTML = stickerHeartMarkup(colorVar);
    } else if (variant === 'double'){
      // Two overlapping hearts, one couple's-symbol icon — the back heart sits slightly lower/behind
      // and a touch more transparent so it clearly reads as a pair, not a smudge.
      span.innerHTML = '<svg viewBox="0 0 46 34" width="100%" height="100%" style="display:block;">' +
          '<path fill="currentColor" opacity="0.75" transform="translate(0,5) scale(0.78)" d="' + HEART_PATH + '"/>' +
          '<path fill="currentColor" transform="translate(14,0) scale(0.78)" d="' + HEART_PATH + '"/>' +
        '</svg>';
    } else {
      span.innerHTML = '<svg viewBox="0 0 32 29" width="100%" height="100%" style="display:block;"><path fill="currentColor" d="' + HEART_PATH + '"/></svg>';
    }
    return span;
  }

  var heartsHost = document.getElementById('hearts');
  for (var i = 0; i < 22; i++){
    // Mix of plain hearts, double-hearts, and glowing sticker hearts for variety.
    var variant = i % 6 === 3 ? 'sticker' : (i % 4 === 0 ? 'double' : 'single');
    var s = makeHeartIcon(HEART_COLOR, 1 + Math.random() * 1.3, variant);
    s.style.left = (Math.random() * 100) + '%';
    s.style.animationDelay = (Math.random() * 11) + 's';
    s.style.animationDuration = (9 + Math.random() * 6) + 's';
    heartsHost.appendChild(s);
  }

  var card = document.getElementById('card');
  var noBtn = document.getElementById('no-btn');
  var yesBtn = document.getElementById('yes-btn');
  var helper = document.getElementById('helper');
  var dodges = 0;

  function reduceMotion(){
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function heartBurst(x, y, count){
    if (reduceMotion()) return;
    for (var i = 0; i < count; i++){
      var sp = makeHeartIcon(HEART_COLOR, 1 + Math.random() * 0.8, i % 5 === 0 ? 'double' : 'single');
      sp.classList.add('heart-burst-item');
      var angle = Math.random() * Math.PI * 2;
      var dist = 60 + Math.random() * 110;
      sp.style.setProperty('--dx', (Math.cos(angle) * dist) + 'px');
      sp.style.setProperty('--dy', (Math.sin(angle) * dist) + 'px');
      sp.style.left = x + 'px';
      sp.style.top = y + 'px';
      sp.style.animationDelay = (Math.random() * 0.15) + 's';
      document.body.appendChild(sp);
      (function(el){
        setTimeout(function(){ el.remove(); }, 1300);
      })(sp);
    }
  }

  function dodge(){
    if (reduceMotion()) return;
    var w = noBtn.offsetWidth || 100;
    var h = noBtn.offsetHeight || 44;
    var pad = 18;
    var maxX = Math.max(0, card.clientWidth - w - pad * 2);
    var maxY = Math.max(0, card.clientHeight - h - pad * 2);
    var x = pad + Math.random() * maxX;
    var y = pad + Math.random() * maxY;

    if (!noBtn.classList.contains('roaming')){
      noBtn.classList.add('roaming');
    }
    noBtn.style.left = x + 'px';
    noBtn.style.top = y + 'px';

    dodges++;
    var scale = Math.min(1.5, 1 + dodges * 0.05);
    yesBtn.style.transform = 'scale(' + scale + ')';
    helper.textContent = DODGE_LINES[Math.min(dodges - 1, DODGE_LINES.length - 1)];
  }

  var SAFE_DIST = 130;
  var MIN_INTERVAL = 220;
  var lastDodge = 0;

  function checkProximity(x, y){
    if (reduceMotion()) return;
    var rect = noBtn.getBoundingClientRect();
    var cx = rect.left + rect.width / 2;
    var cy = rect.top + rect.height / 2;
    var dist = Math.hypot(x - cx, y - cy);
    var now = Date.now();
    if (dist < SAFE_DIST && now - lastDodge > MIN_INTERVAL){
      lastDodge = now;
      dodge();
    }
  }

  document.addEventListener('mousemove', function(e){
    checkProximity(e.clientX, e.clientY);
  }, { passive: true });

  document.addEventListener('touchmove', function(e){
    if (e.touches && e.touches[0]) checkProximity(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: true });

  noBtn.addEventListener('touchstart', function(e){
    e.preventDefault();
    lastDodge = Date.now();
    dodge();
  }, { passive: false });

  noBtn.addEventListener('click', function(e){
    e.preventDefault();
    lastDodge = Date.now();
    dodge();
  });

  function showScene(id){
    document.querySelectorAll('.scene').forEach(function(el){
      el.classList.remove('active');
    });
    document.getElementById(id).classList.add('active');
  }

  yesBtn.addEventListener('click', function(){
    var r = yesBtn.getBoundingClientRect();
    heartBurst(r.left + r.width / 2, r.top + r.height / 2, 26);
    showScene('scene-plan');
  });

  // Clicking anywhere in the field — including the icon — opens the native picker.
  ['date-input', 'time-input'].forEach(function(id){
    var el = document.getElementById(id);
    var wrap = el.closest('.field-wrap');
    (wrap || el).addEventListener('click', function(){
      if (typeof el.showPicker === 'function'){
        try { el.showPicker(); } catch (err) { /* ignore — falls back to native click behavior */ }
      }
    });
  });

  document.getElementById('plan-form').addEventListener('submit', function(e){
    e.preventDefault();
    var dateVal = document.getElementById('date-input').value;
    var timeVal = document.getElementById('time-input').value;
    if (!dateVal || !timeVal) return;

    var d = new Date(dateVal + 'T' + timeVal);
    var dateStr = d.toLocaleDateString(LOCALE, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    var timeStr = d.toLocaleTimeString(LOCALE, { hour: 'numeric', minute: '2-digit' });

    document.getElementById('thanks-msg').textContent =
      THANKS_TEMPLATE.replace('{date}', dateStr).replace('{time}', timeStr);

    showScene('scene-thanks');

    if (!reduceMotion()){
      var burst = document.getElementById('burst');
      burst.innerHTML = '';
      for (var i = 0; i < 16; i++){
        var sp = makeHeartIcon(HEART_COLOR, 1 + Math.random() * 0.5, i % 4 === 0 ? 'double' : 'single');
        sp.style.setProperty('--dx', (Math.random() * 160 - 80) + 'px');
        sp.style.left = (35 + Math.random() * 30) + '%';
        sp.style.animationDelay = (Math.random() * 0.3) + 's';
        burst.appendChild(sp);
      }
    }

    fetch(SUBMIT_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ date: dateVal, time: timeVal })
    }).catch(function(err){ console.error('Submission failed to reach the server:', err); });
  });
})();
</script>
</body>
</html>
