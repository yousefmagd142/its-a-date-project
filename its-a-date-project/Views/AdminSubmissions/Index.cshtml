@model List<DateSubmission>
@{
    ViewData["Title"] = "Submissions";
    var invites = ViewData["Invites"] as List<Invite> ?? new();
    var selected = ViewData["SelectedInviteId"] as int?;
}
@await Html.PartialAsync("_AdminNav")

<h1 class="mb-3">Submissions</h1>

<form method="get" class="mb-3 col-md-3">
    <select name="inviteId" class="form-select" onchange="this.form.submit()">
        <option value="">All invites</option>
        @foreach (var invite in invites)
        {
            <option value="@invite.Id" selected="@(selected == invite.Id)">@invite.Slug</option>
        }
    </select>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Invite</th>
            <th>Chosen date/time</th>
            <th>Submitted</th>
            <th>Email sent</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Invite?.Slug</td>
            <td>@s.ChosenDateUtc.ToString("f")</td>
            <td>@s.SubmittedAtUtc.ToString("f")</td>
            <td>@(s.EmailSent ? "Yes" : "No")</td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="4" class="text-muted">No submissions yet.</td></tr>
    }
    </tbody>
</table>
